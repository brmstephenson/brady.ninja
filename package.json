{
  "name": "brady.ninja",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio monorepo for brady.ninja",
  "author": "Brady Stephenson <brmstephenson@gmail.com> (https://brady.ninja)",
  "license": "MIT",
  "homepage": "https://brady.ninja",
  "repository": {
    "type": "git",
    "url": "https://github.com/brmstephenson/brady.ninja.git"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @brady-ninja/web --filter @brady-ninja/api dev",
    "dev:web": "pnpm --filter @brady-ninja/web dev",
    "dev:api": "pnpm --filter @brady-ninja/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @brady-ninja/web build",
    "build:api": "pnpm --filter @brady-ninja/api build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "db:studio": "pnpm --filter @brady-ninja/api db:studio",
    "db:generate": "pnpm --filter @brady-ninja/api db:generate",
    "db:migrate": "pnpm --filter @brady-ninja/api db:migrate",
    "db:seed": "pnpm --filter @brady-ninja/api db:seed"
  },
  "packageManager": "pnpm@10.25.0"
}
