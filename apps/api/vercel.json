{
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "framework": "express",
  "functions": {
    "src/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/trpc/:path*",
      "destination": "/api/trpc/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
