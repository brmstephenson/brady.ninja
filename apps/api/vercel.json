{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "framework": "express",
  "functions": {
    "src/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/trpc/:path*",
      "destination": "/api/trpc/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/resume/:path*",
      "destination": "/api/resume/:path*"
    }
  ]
}
