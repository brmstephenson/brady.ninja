{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/trpc/:path*",
      "destination": "/api/src/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/src/api/index"
    }
  ]
}
